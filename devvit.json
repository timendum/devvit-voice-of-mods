{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "voice-of-mods",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true
    }
  },
  "menu": {
    "items": [
      {
        "label": "Reply as Mod",
        "description": "And view the real moderator for created comments",
        "forUserType": "moderator",
        "location": "post",
        "endpoint": "/internal/menu/reply-as-mod"
      },
      {
        "label": "Reply as Mod",
        "description": "And view the real moderator for created comments",
        "forUserType": "moderator",
        "location": "comment",
        "endpoint": "/internal/menu/reply-as-mod"
      }
    ]
  },
  "forms": {
    "write-comment": "/internal/forms/write-comment-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/app-install",
    "onAppUpgrade": "/internal/triggers/app-upgrade"
  }
}
